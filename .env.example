# Where Crew listens. Use 0.0.0.0:8787 behind a reverse proxy.
CREW_ADDR=127.0.0.1:8787

# SQLite file (WAL mode). Keep it on a local disk, not a network share.
CREW_DB=data/crew.db

# The Laravel app that owns identity and sends the codes.
PAYTRACKIFY_URL=http://127.0.0.1:8012
PAYTRACKIFY_TIMEOUT=8s

# How long a validated session is trusted before re-checking.
CREW_SESSION_CACHE_TTL=60s

# 32-byte hex or base64 key for encrypting provider API keys.
# Production: set this. If empty, a 0600 file is created beside the database.
# openssl rand -hex 32
CREW_SECRET_KEY=

# Set true behind HTTPS (production forces this).
CREW_SECURE_COOKIES=false
CREW_ENV=development

# Included model: used when a helper has no personal key. The key stays on the
# server and is never sent to helpers.
CREW_PLATFORM_PROVIDER=deepseek
CREW_PLATFORM_MODEL=deepseek-chat
CREW_PLATFORM_API_KEY=
# CREW_PLATFORM_BASE_URL=

# New companies start with this monthly AI budget (USD); 0 means unlimited.
CREW_DEFAULT_AI_BUDGET_USD=2

# Token for PayTrackify's admin monitor to read aggregate stats.
CREW_ADMIN_TOKEN=


# Outbound email (server SMTP relay). Defaults to localhost.
CREW_SMTP_ADDR=127.0.0.1:25
CREW_SMTP_FROM=Crew <noreply@paytrackify.com>
# CREW_SMTP_USER=
# CREW_SMTP_PASS=
