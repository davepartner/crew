# Where Crew listens. Use 0.0.0.0:8787 behind a reverse proxy.
CREW_ADDR=127.0.0.1:8787

# SQLite file (WAL mode). Keep it on a local disk, not a network share.
CREW_DB=data/crew.db

# The Laravel app that owns identity and sends the codes.
PAYTRACKIFY_URL=http://127.0.0.1:8012
PAYTRACKIFY_TIMEOUT=8s

# How long a validated session is trusted before re-checking.
CREW_SESSION_CACHE_TTL=60s

# Set true behind HTTPS (production forces this).
CREW_SECURE_COOKIES=false
CREW_ENV=development
